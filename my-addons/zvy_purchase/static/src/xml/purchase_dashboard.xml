<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zvy_purchase.PurchaseDashboardCard">
        <div class="o_zvy_purchase_dashboard_card border bg-view rounded">
            <div class="o_zvy_purchase_dashboard_card_header d-flex align-items-center gap-2 mb-2">
                <i t-attf-class="fa {{ this.props.card.icon }} fa-lg text-primary" role="img" t-att-title="this.props.card.title"/>
                <span class="fw-bold text-truncate" t-esc="this.props.card.title"/>
            </div>
            <div class="o_zvy_purchase_dashboard_card_count mb-3" t-esc="this.props.card.count"/>
            <button type="button" class="btn btn-primary w-100" t-on-click="this.onCheckClick" t-esc="this.checkLabel"/>
        </div>
    </t>

    <t t-name="zvy_purchase.PurchaseDashboard">
        <Layout display="this.display" className="'o_zvy_purchase_dashboard'">
            <div class="o_zvy_purchase_dashboard_content p-3">
                <t t-if="!this.state.cards.length">
                    <div class="text-muted" t-esc="this.emptyLabel"/>
                </t>
                <div t-else="" class="o_zvy_purchase_dashboard_grid">
                    <PurchaseDashboardCard
                        t-foreach="this.state.cards"
                        t-as="card"
                        t-key="card.key"
                        card="card"
                        onCheck.bind="this.openCard"/>
                </div>
            </div>
        </Layout>
    </t>
</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="portal_tenders" model="portal.entry">
        <field name="name">Tenders</field>
        <field name="description">View published tenders and submit your bids</field>
        <field name="url">/my/tenders</field>
        <field name="image" type="bytes" file="web/static/img/folder.svg"/>
        <field name="placeholder_count">tender_count</field>
        <field name="category">service_category</field>
        <field name="sequence" eval="95"/>
    </record>
</odoo>

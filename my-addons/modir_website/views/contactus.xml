<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="contactus" inherit_id="website.contactus" name="Modir.Digital Contact Us">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure modir-contact">

                <section class="modir-contact__hero" data-name="Contact Hero">
                    <div class="modir-contact__atmosphere" aria-hidden="true">
                        <div class="modir-contact__grid"/>
                        <div class="modir-contact__glow"/>
                    </div>
                    <div class="container modir-contact__hero-inner">
                        <p class="modir-hero__brand" data-modir-reveal="1">Modir.Digital</p>
                        <h1 class="modir-contact__title" data-modir-reveal="2">Contact us</h1>
                        <p class="modir-contact__lead" data-modir-reveal="3">
                            Tell us about your organization, processes, and goals —
                            we will help you choose the right path for ERP and related systems.
                        </p>
                    </div>
                </section>

                <section class="modir-contact__body" data-name="Contact Form">
                    <div class="container">
                        <div class="modir-contact__layout">
                            <div class="modir-contact__form-panel" data-modir-reveal="4">
                                <header class="modir-section-head">
                                    <p class="modir-eyebrow">Message</p>
                                    <h2 class="modir-section-title">Send a message</h2>
                                </header>
                                <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                    <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required modir-contact__form" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                        <div class="s_website_form_rows row s_col_no_bgcolor">
                                            <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                                                <label class="s_website_form_label" for="contact1">
                                                    <span class="s_website_form_label_content">Name</span>
                                                    <span class="s_website_form_mark"> *</span>
                                                </label>
                                                <input id="contact1" type="text" placeholder="Your name" class="form-control s_website_form_input" name="name" required="" data-fill-with="name"/>
                                            </div>
                                            <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                                <label class="s_website_form_label" for="contact2">
                                                    <span class="s_website_form_label_content">Phone Number</span>
                                                </label>
                                                <input id="contact2" type="tel" placeholder="+98 …" class="form-control s_website_form_input" name="phone" data-fill-with="phone"/>
                                            </div>
                                            <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required" data-type="email" data-name="Field">
                                                <label class="s_website_form_label" for="contact3">
                                                    <span class="s_website_form_label_content">Email</span>
                                                    <span class="s_website_form_mark"> *</span>
                                                </label>
                                                <input id="contact3" type="email" placeholder="you@company.com" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email"/>
                                            </div>
                                            <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                                <label class="s_website_form_label" for="contact4">
                                                    <span class="s_website_form_label_content">Company</span>
                                                </label>
                                                <input id="contact4" type="text" placeholder="Organization name" class="form-control s_website_form_input" name="company" data-fill-with="parent_name"/>
                                            </div>
                                            <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                                <label class="s_website_form_label" for="contact5">
                                                    <span class="s_website_form_label_content">Subject</span>
                                                    <span class="s_website_form_mark"> *</span>
                                                </label>
                                                <input id="contact5" type="text" placeholder="What do you need help with?" class="form-control s_website_form_input" name="subject" required=""/>
                                            </div>
                                            <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="text" data-name="Field">
                                                <label class="s_website_form_label" for="contact6">
                                                    <span class="s_website_form_label_content">Message</span>
                                                    <span class="s_website_form_mark"> *</span>
                                                </label>
                                                <textarea id="contact6" placeholder="Share context, constraints, and goals." class="form-control s_website_form_input" name="description" required="" rows="6"/>
                                                <span class="s_website_form_field_description small form-text">We typically respond within 1–2 business days.</span>
                                            </div>
                                            <div class="mb-3 col-12 s_website_form_field s_website_form_dnone">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label" for="contact7">
                                                        <span class="s_website_form_label_content">Email To</span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input id="contact7" type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-0 col-12 s_website_form_submit s_website_form_no_submit_label" data-name="Submit Button">
                                                <span id="s_website_form_result"/>
                                                <a href="#" role="button" class="modir-btn modir-btn--primary s_website_form_send">Send Message</a>
                                            </div>
                                        </div>
                                    </form>
                                </section>
                            </div>

                            <aside class="modir-contact__aside" data-modir-reveal="5">
                                <header class="modir-section-head">
                                    <p class="modir-eyebrow">Direct</p>
                                    <h2 class="modir-section-title">Reach us directly</h2>
                                </header>
                                <ul class="modir-contact__channels">
                                    <li>
                                        <span class="modir-contact__channel-label">Email</span>
                                        <a href="mailto:info@modir.digital">info@modir.digital</a>
                                    </li>
                                    <li>
                                        <span class="modir-contact__channel-label">Phone</span>
                                        <a href="tel:+989213861658">+98 921 3861 658</a>
                                    </li>
                                    <li>
                                        <span class="modir-contact__channel-label">Focus</span>
                                        <p>ERP, KM, DMS, CRM, PM, PLM, and MRP — consultancy and products.</p>
                                    </li>
                                </ul>
                            </aside>
                        </div>
                    </div>
                </section>

                <section class="modir-contact__faq" data-name="Contact FAQ">
                    <div class="container">
                        <header class="modir-section-head">
                            <p class="modir-eyebrow">FAQ</p>
                            <h2 class="modir-section-title">Common questions</h2>
                        </header>
                        <div class="modir-contact__faq-grid">
                            <article>
                                <h3>How do engagements start?</h3>
                                <p>We begin with discovery: your processes, constraints, and goals — then recommend a clear path.</p>
                            </article>
                            <article>
                                <h3>Do you implement and advise?</h3>
                                <p>Yes. Consultancy covers design and oversight; products extend planning, operations, and manufacturing control.</p>
                            </article>
                            <article>
                                <h3>Which systems do you cover?</h3>
                                <p>ERP, knowledge, documents, CRM, projects, product lifecycle, and manufacturing planning.</p>
                            </article>
                        </div>
                    </div>
                </section>

            </div>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout_fonts" inherit_id="website.layout" name="IT Orbit Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;500&amp;family=Space+Grotesk:wght@400;500;600;700&amp;family=Vazirmatn:wght@400;500;600;700;800&amp;display=swap"/>
        </xpath>
    </template>
</odoo>

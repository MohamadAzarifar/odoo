<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage" inherit_id="website.homepage" name="IT Orbit Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure ito-home">

                <section class="ito-hero" data-name="IT Orbit Hero">
                    <div class="ito-hero__field" aria-hidden="true">
                        <canvas class="ito-hero__pixels"/>
                    </div>
                    <div class="container ito-hero__grid">
                        <div class="ito-hero__copy">
                            <p class="ito-hero__brand" data-ito-reveal="1">
                                <span class="ito-hero__brand-fa">مدارگسترش</span>
                                <span class="ito-hero__brand-sep" aria-hidden="true"/>
                                <span class="ito-hero__brand-en">IT Orbit</span>
                            </p>
                            <h1 class="ito-hero__title" data-ito-reveal="2">Native software platforms for large organizations</h1>
                            <p class="ito-hero__lead" data-ito-reveal="3">A knowledge-based company ranked first by the Supreme Council of Informatics — we unify software production, processes, business rules, security, and education.</p>
                            <div class="ito-hero__actions" data-ito-reveal="4">
                                <a href="/contactus" class="ito-btn ito-btn--primary">Contact us</a>
                                <a href="#products" class="ito-btn ito-btn--secondary">View products</a>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="ito-products" id="products" data-name="IT Orbit Products">
                    <div class="container">
                        <header class="ito-section-head" data-ito-reveal="s">
                            <p class="ito-eyebrow">Products</p>
                            <h2 class="ito-section-title">The IT Orbit platforms</h2>
                            <p class="ito-section-lead">Five homegrown systems for software production, process management, business rules, access security, and education.</p>
                        </header>
                        <ol class="ito-products__rail">
                            <li class="ito-products__row" data-ito-reveal="s">
                                <span class="ito-products__index">01</span>
                                <div class="ito-products__body">
                                    <h3 class="ito-products__code">Orbit@ll</h3>
                                    <p class="ito-products__subtitle">Software production platform</p>
                                    <p class="ito-products__outcome">Cut the cost and time of building enterprise software.</p>
                                </div>
                            </li>
                            <li class="ito-products__row" data-ito-reveal="s">
                                <span class="ito-products__index">02</span>
                                <div class="ito-products__body">
                                    <h3 class="ito-products__code">EPIC</h3>
                                    <p class="ito-products__subtitle">Business process management</p>
                                    <p class="ito-products__outcome">Turn organizational processes into software you can run — without a heavy dependence on specialists.</p>
                                </div>
                            </li>
                            <li class="ito-products__row" data-ito-reveal="s">
                                <span class="ito-products__index">03</span>
                                <div class="ito-products__body">
                                    <h3 class="ito-products__code">ACE</h3>
                                    <p class="ito-products__subtitle">Business rules management</p>
                                    <p class="ito-products__outcome">Define your business rules and keep system behavior precise and controllable.</p>
                                </div>
                            </li>
                            <li class="ito-products__row" data-ito-reveal="s">
                                <span class="ito-products__index">04</span>
                                <div class="ito-products__body">
                                    <h3 class="ito-products__code">Citadel</h3>
                                    <p class="ito-products__subtitle">Security and access control</p>
                                    <p class="ito-products__outcome">RBAC and BLP for sensitive systems — security at the infrastructure layer.</p>
                                </div>
                            </li>
                            <li class="ito-products__row" data-ito-reveal="s">
                                <span class="ito-products__index">05</span>
                                <div class="ito-products__body">
                                    <h3 class="ito-products__code">NAD</h3>
                                    <p class="ito-products__subtitle">Integrated university system</p>
                                    <p class="ito-products__outcome">The education ERP, with more than 60 modules, for running and improving university services.</p>
                                </div>
                            </li>
                        </ol>
                    </div>
                </section>

                <section class="ito-why" id="about" data-name="IT Orbit Why">
                    <div class="container ito-why__grid">
                        <header class="ito-section-head" data-ito-reveal="s">
                            <p class="ito-eyebrow">Why IT Orbit</p>
                            <h2 class="ito-section-title">Trust comes from clarity and a track record</h2>
                        </header>
                        <div class="ito-why__copy" data-ito-reveal="s">
                            <p>A team of experienced specialists, using current tools and technology, delivers solutions for national projects. IT Orbit does not only apply knowledge — it produces knowledge and innovation.</p>
                            <p>With a strong record on large-scale national projects, we have stayed among the pioneers of the country’s software industry and offer a wide range of knowledge-based products.</p>
                            <ul class="ito-why__stats" aria-label="Highlights">
                                <li><strong>+20</strong><span>Years of experience</span></li>
                                <li><strong>Rank 1</strong><span>Supreme Council of Informatics</span></li>
                                <li><strong>+60</strong><span>modules in NAD</span></li>
                            </ul>
                        </div>
                    </div>
                </section>

                <section class="ito-cta" data-name="IT Orbit CTA">
                    <div class="container ito-cta__inner" data-ito-reveal="s">
                        <h2 class="ito-cta__title">Ready to talk about the next project?</h2>
                        <p class="ito-cta__lead">
                            Phone <a href="tel:+982188373555">021-88373555</a>
                            ·
                            <a href="mailto:Info@itorbit.net">Info@itorbit.net</a>
                        </p>
                        <a href="/contactus" class="ito-btn ito-btn--primary">Contact us</a>
                    </div>
                </section>

            </div>
        </xpath>
    </template>
</odoo>

#. module: ai_helpdesk
#: model:ir.module.module,shortdesc:base.module_ai_helpdesk
msgid "AI Helpdesk"
msgstr "IA y Soporte al cliente"

#. module: ai_helpdesk
#: model:ir.module.module,summary:base.module_ai_helpdesk
msgid "Augment Helpdesk with AI Agents."
msgstr "Mejora Soporte al cliente con agentes de IA."

#. module: ai_helpdesk
#: model_terms:ai.prompt.button,prompt:ai_helpdesk.ai_prompt_top_ticket_cause
msgid ""
"Search for helpdesk tickets (model_name: helpdesk.ticket), retrieve the most "
"recent 5 tickets and summarize what they complain about (field_name: "
"description).\n"
"Include the ticket name (field_name: name) in the response. Don't mention "
"model_name or field_name or any record ids in the response."
msgstr ""
"Busca los tickets de soporte al cliente (model_name: helpdeks.ticket), "
"recupera los 5 tickets más recientes y haz un resumen el motivo de las "
"quejas (field_name: description).\n"
"Incluye el nombre del ticket (field_name: name) en la respuesta. No "
"menciones los datos model_name, field_name o cualquier id de registro en la "
"respuesta."

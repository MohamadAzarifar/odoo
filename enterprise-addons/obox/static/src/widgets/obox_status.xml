<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="obox.OboxStatus">
        <div class="d-flex gap-2">
            <i
                class="oi"
                data-icon="wifi"
                t-att-title="this.state.lan.status ? 'Local Network reachable' : 'Local Network unreachable'"
                t-att-class="{'text-success': this.state.lan.status, 'text-danger': !this.state.lan.status}"
            />
            <i
                class="oi"
                data-icon="cloud"
                t-att-title="this.state.wan.status ? 'WebSocket connected' : 'WebSocket disconnected'"
                t-att-class="{'text-success': this.state.wan.status, 'text-danger': !this.state.wan.status}"
            />
        </div>
    </t>
</templates>
